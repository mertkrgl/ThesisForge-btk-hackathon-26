# ── App
ENV=dev                                      # dev | demo | production
LOG_LEVEL=INFO
THESISFORGE_MODE=live                        # live | fixture
CACHE_BACKEND=memory                         # memory | redis

# ── DB
# Gün 4B önerilen yol (PgBouncer): localhost:6432
# Doğrudan Postgres için 5433 kullanabilirsin.
DATABASE_URL=postgresql+asyncpg://tf:tf@localhost:6432/thesisforge

# ── Redis (Aşama 13'te eklenir, dev'de boş)
REDIS_URL=

# ── LLM (Gemini-only stack)
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_EMBED_DIMENSIONS=768

# ── Data sources (dev'de .env.probe'tan miras alınabilir)
TCMB_EVDS_KEY=
MKK_API_KEY=
MKK_API_SECRET=

# ── Rate limits (request/sec)
ISYATIRIM_RATE_PER_SEC=1
YFINANCE_RATE_PER_SEC=2
MKK_RATE_PER_SEC=2
TCMB_RATE_PER_SEC=2
BORSAPY_RATE_PER_SEC=2

# ── Demo
DEMO_KILLSWITCH_THRESHOLD_SEC=90
DEMO_TOOL_FAIL_THRESHOLD=3

# ── Paths (opsiyonel override)
# PRODUCT_SCRIPTS_PATH=../scripts/product
# FIXTURE_ROOT=./fixtures
